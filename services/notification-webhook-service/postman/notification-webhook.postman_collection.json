              "const res = pm.response.json();",
              "pm.collectionVariables.set('subscriptionId', res.id);",
              "pm.collectionVariables.set('webhookSecret', res.secret);",
              "pm.test('Secret is returned on creation', function () {",
              "    pm.expect(res.secret).to.be.a('string');",
              "    pm.expect(res.secret.startsWith('whsec_')).to.be.true;",
