    {
      "name": "12. Check Delivery Details (After Dispatcher Runs)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const res = pm.response.json();",
              "pm.test('Payload contains expected fields and NO customerUserId', function () {",
              "    const parsedPayload = JSON.parse(res.payload);",
              "    pm.expect(parsedPayload.eventId).to.be.a('string');",
              "    pm.expect(parsedPayload.eventType).to.eql('parcel.status-changed');",
              "    pm.expect(parsedPayload.data.parcelId).to.be.a('string');",
              "    pm.expect(parsedPayload.data.customerUserId).to.be.undefined;",
              "});"
            ]
          }
        }
