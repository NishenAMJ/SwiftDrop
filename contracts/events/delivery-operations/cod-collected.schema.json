{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swiftdrop.dev/contracts/events/delivery-operations/cod-collected.schema.json",
  "title": "COD collected",
  "description": "Proposal for team review. Published by Delivery Operations only after a courier records a completed Cash on Delivery collection. Payment & Settlement validates the copied pricing values against the authoritative Parcel & Pricing snapshot before posting financial records.",
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "delivery.cod-collected"
        },
        "version": {
          "const": 1
        },
        "producer": {
          "const": "delivery-operations-service"
        },
        "data": {
          "type": "object",
          "required": [
            "bookingId",
            "trackingNumber",
            "pricingSnapshotId",
            "merchantId",
            "courierId",
            "deliveryAttemptId",
            "paymentMethod",
            "expectedAmount",
            "collectedAmount",
            "currency",
            "collectedAt"
          ],
          "properties": {
            "bookingId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "description": "Stable Parcel & Pricing booking identifier."
            },
            "trackingNumber": {
              "type": "string",
              "pattern": "^SWD-[0-9]{4}-[0-9]{6,}$"
            },
            "pricingSnapshotId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "description": "Opaque immutable Parcel & Pricing snapshot identifier."
            },
            "merchantId": {
              "type": "string",
              "format": "uuid"
            },
            "courierId": {
              "type": "string",
              "format": "uuid"
            },
            "deliveryAttemptId": {
              "type": "string",
              "format": "uuid"
            },
            "paymentMethod": {
              "const": "COD"
            },
            "expectedAmount": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 9999999999.99,
              "multipleOf": 0.01,
              "description": "Copy of the immutable amount to collect; Payment & Settlement must validate it against Parcel & Pricing."
            },
            "collectedAmount": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 9999999999.99,
              "multipleOf": 0.01
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "collectedAt": {
              "type": "string",
              "format": "date-time",
              "description": "When the courier collected the cash, in UTC."
            }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
