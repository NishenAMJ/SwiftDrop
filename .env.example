# Copy this file to .env for first-time setup.
# Replace every password placeholder with a private value. Never commit .env or secrets.
# Use plain KEY=value entries without quotes or inline comments.

# PostgreSQL
POSTGRES_ADMIN_PASSWORD=change-me-postgres-admin
IDENTITY_DB_PASSWORD=change-me-identity-db
PARCEL_DB_PASSWORD=change-me-parcel-db
TRACKING_DB_PASSWORD=change-me-tracking-db
PAYMENT_DB_PASSWORD=change-me-payment-db
COMMUNICATION_DB_PASSWORD=change-me-communication-db

# RabbitMQ
RABBITMQ_USER=swiftdrop
RABBITMQ_PASSWORD=change-me-rabbitmq

# Identity service
IDENTITY_COOKIE_SECURE=false
FRONTEND_BASE_URL=http://localhost:4200
DISPATCHER_BOOTSTRAP_EMAIL=
DISPATCHER_BOOTSTRAP_PASSWORD=
DISPATCHER_BOOTSTRAP_NAME=SwiftDrop Dispatcher
IDENTITY_RATE_LIMIT_ENABLED=true

# Optional Google OAuth login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Payment service
SPRING_PROFILES_ACTIVE=default
PAYMENT_PRICING_STUB_ENABLED=false
PAYMENT_PRICING_BASE_URL=http://parcel-pricing-service:8082
PAYMENT_PAYHERE_MERCHANT_ID=
PAYMENT_PAYHERE_MERCHANT_SECRET=
PAYMENT_PAYHERE_APP_ID=
PAYMENT_PAYHERE_APP_SECRET=
PAYMENT_PAYHERE_BASE_URL=https://sandbox.payhere.lk
PAYMENT_PAYHERE_NOTIFY_URL=
PAYMENT_PAYHERE_RETURN_URL=http://localhost:4200/payments/return
PAYMENT_PAYHERE_CANCEL_URL=http://localhost:4200/payments/cancel

# API Gateway JWT and upstream services
IDENTITY_ISSUER_URI=swiftdrop-identity
IDENTITY_AUDIENCE=swiftdrop-api
IDENTITY_JWKS_URI=http://identity-merchant-service:8081/.well-known/jwks.json
GATEWAY_IDENTITY_JWKS_URI=http://identity-merchant-service:8081/.well-known/jwks.json
GATEWAY_IDENTITY_SERVICE_URI=http://identity-merchant-service:8081
GATEWAY_PARCEL_SERVICE_URI=http://parcel-pricing-service:8082
GATEWAY_DELIVERY_SERVICE_URI=http://host.docker.internal:8083
GATEWAY_TRACKING_SERVICE_URI=http://tracking-reporting-service:8084

# Notification service
MAIL_HOST=mailpit
MAIL_PORT=1025
NOTIFICATION_FROM_EMAIL=noreply@swiftdrop.dev
TRACKING_BASE_URL=http://localhost:4200/track
