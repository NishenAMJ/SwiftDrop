# Copy to .env only for first-time setup. For an existing .env, add missing keys.
# Replace password placeholders in .env; never commit real credentials.
# Use plain KEY=value entries without quotes or inline comments.

# PostgreSQL (required by Docker Compose).
POSTGRES_ADMIN_PASSWORD=YourAdminPasswordHere
IDENTITY_DB_PASSWORD=YourIdentityPasswordHere
PAYMENT_DB_PASSWORD=YourPaymentPasswordHere
# RabbitMQ (required by Docker Compose; shared by broker and payment service).
RABBITMQ_USER=swiftdrop
RABBITMQ_PASSWORD=YourRabbitPasswordHere

DISPATCHER_BOOTSTRAP_EMAIL=
DISPATCHER_BOOTSTRAP_PASSWORD=
DISPATCHER_BOOTSTRAP_NAME=SwiftDrop Dispatcher

# Google login (optional; on only when both are set). Do not commit actual values.
# Setup steps: services/identity-merchant-service/README.md, section "Google login".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# PayHere sandbox credentials; do not commit actual values.
PAYMENT_PAYHERE_MERCHANT_ID=
PAYMENT_PAYHERE_MERCHANT_SECRET=
PAYMENT_PAYHERE_APP_ID=
PAYMENT_PAYHERE_APP_SECRET=
PAYMENT_PAYHERE_NOTIFY_URL=
# Local stub is opt-in and requires SPRING_PROFILES_ACTIVE=local.
PAYMENT_PRICING_STUB_ENABLED=false
PARCEL_DB_PASSWORD=YourParcelPasswordHere
COMMUNICATION_DB_PASSWORD=YourCommunicationPasswordHere
TRACKING_DB_PASSWORD=YourTrackingPasswordHere

# API Gateway upstreams. Defaults assume the services run on the host; Compose
# connects Payment directly over its internal network.
GATEWAY_IDENTITY_JWKS_URI=http://host.docker.internal:8081/.well-known/jwks.json
GATEWAY_IDENTITY_SERVICE_URI=http://host.docker.internal:8081
GATEWAY_PARCEL_SERVICE_URI=http://host.docker.internal:8082
GATEWAY_DELIVERY_SERVICE_URI=http://host.docker.internal:8083
GATEWAY_TRACKING_SERVICE_URI=http://host.docker.internal:8084
