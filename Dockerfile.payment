FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /workspace
COPY services/payment-settlement-service/pom.xml services/payment-settlement-service/
COPY services/payment-settlement-service/.mvn services/payment-settlement-service/.mvn
COPY services/payment-settlement-service/mvnw services/payment-settlement-service/
RUN chmod +x services/payment-settlement-service/mvnw
COPY services/payment-settlement-service/src services/payment-settlement-service/src
RUN cd services/payment-settlement-service && ./mvnw -B package -DskipTests

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /workspace/services/payment-settlement-service/target/*.jar app.jar
EXPOSE 8085
ENTRYPOINT ["java", "-jar", "/app/app.jar"]