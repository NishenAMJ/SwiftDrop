# Copy to .env.production and fill every blank required value.
# Never commit the populated file. Use hex passwords to avoid interpolation/quoting issues.
# Production target: a Linux host with Docker Compose 2.24.4+.
APP_DOMAIN=
ACME_EMAIL=
POSTGRES_ADMIN_PASSWORD=
IDENTITY_DB_PASSWORD=
PARCEL_DB_PASSWORD=
TRACKING_DB_PASSWORD=
PAYMENT_DB_PASSWORD=
DELIVERY_DB_PASSWORD=
COMMUNICATION_DB_PASSWORD=
RABBITMQ_USER=swiftdrop
RABBITMQ_PASSWORD=
# Absolute host paths; preserve these secrets separately from data backups.
IDENTITY_JWT_PRIVATE_KEY_FILE=
WEBHOOK_ENCRYPTION_KEY=
PARCEL_INTERNAL_API_KEY=
BACKUP_DIR=

# Authenticated SMTP with required STARTTLS, not Mailpit or a real SMS provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFICATION_FROM_EMAIL=

# First deployment only. Remove bootstrap password after the dispatcher exists.
DISPATCHER_BOOTSTRAP_EMAIL=
DISPATCHER_BOOTSTRAP_PASSWORD=
DISPATCHER_BOOTSTRAP_NAME=SwiftDrop Dispatcher
# Optional Google OAuth; leave blank to keep disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Enable only after verifying your COD/cancellation event flow in staging.
PAYMENT_COD_CONSUMER_ENABLED=false
PAYMENT_COD_VERIFICATION_MODE=parcel
PAYMENT_CANCELLATION_CONSUMER_ENABLED=false
SWIFTDROP_CANCELLATION_FEE=0.00
# No PayHere credentials: this release does not integrate real online payments.
